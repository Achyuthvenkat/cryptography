    <!-- Feature descriptions -->
    <string name="desc_merge_pdf">Combine multiple PDFs into one in the order you choose.</string>
    <string name="desc_split_pdf">Separate pages into individual PDF files or ranges.</string>
    <string name="desc_compress_pdf">Reduce file size while optimising for maximal PDF quality.</string>
    <string name="desc_pdf_to_word">Convert PDF files into editable DOC and DOCX documents.</string>
    <string name="desc_pdf_to_ppt">Turn PDF files into editable PPT and PPTX slideshows.</string>
    <string name="desc_pdf_to_excel">Pull data from PDFs into Excel spreadsheets.</string>
    <string name="desc_word_to_pdf">Make DOC and DOCX files easy to read by converting them to PDF.</string>
    <string name="desc_ppt_to_pdf">Make PPT and PPTX slideshows easy to view by converting them to PDF.</string>
    <string name="desc_excel_to_pdf">Make Excel spreadsheets easy to read by converting to PDF.</string>
    <string name="desc_edit_pdf">Add text, images, shapes or freehand annotations to a PDF.</string>
    <string name="desc_pdf_to_jpg">Convert each PDF page into a JPG image.</string>
    <string name="desc_jpg_to_pdf">Convert JPG images to PDF in seconds.</string>
    <string name="desc_sign_pdf">Draw and stamp your signature onto a PDF document.</string>
    <string name="desc_watermark_pdf">Stamp an image or text over your PDF in seconds.</string>
    <string name="desc_rotate_pdf">Rotate your PDFs — even multiple PDFs at once.</string>
    <string name="desc_html_to_pdf">Convert webpages in HTML to PDF by URL.</string>
    <string name="desc_unlock_pdf">Remove PDF password security, giving you freedom to use it.</string>
    <string name="desc_protect_pdf">Protect PDF files with a password. Encrypt PDF documents.</string>
    <string name="desc_organize_pdf">Sort and delete pages of your PDF file however you like.</string>
    <string name="desc_pdf_to_pdfa">Transform your PDF to PDF/A for long-term archiving.</string>
    <string name="desc_repair_pdf">Repair a damaged PDF and recover data from corrupt files.</string>
    <string name="desc_page_numbers">Add page numbers into PDFs. Choose position, dimensions, typography.</string>
    <string name="desc_scan_to_pdf">Capture document scans from your camera and convert to PDF.</string>
    <string name="desc_ocr_pdf">Convert scanned PDFs into searchable and selectable documents.</string>
    <string name="desc_compare_pdf">Side-by-side document comparison to spot changes between versions.</string>
    <string name="desc_redact_pdf">Permanently remove sensitive information from a PDF.</string>
    <string name="desc_crop_pdf">Crop margins or select specific areas of a PDF.</string>

